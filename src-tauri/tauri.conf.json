{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WM Market",
  "version": "0.1.0",
  "identifier": "com.wmmarket.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WM Market",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.svg"]
  }
}
